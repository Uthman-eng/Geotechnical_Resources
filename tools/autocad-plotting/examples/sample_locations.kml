      <Placemark><name>BH02</name><Point><coordinates>-1.4285,53.2806,0</coordinates></Point></Placemark>
      <Placemark><name>BH03</name><Point><coordinates>-1.4270,53.2799,0</coordinates></Point></Placemark>
    </Folder>
    <Folder>
      <name>Trial Pits</name>
      <Placemark><name>TP01</name><Point><coordinates>-1.4292,53.2794,0</coordinates></Point></Placemark>
      <Placemark><name>TP02</name><Point><coordinates>-1.4278,53.2810,0</coordinates></Point></Placemark>
    </Folder>
  </Document>
</kml>
